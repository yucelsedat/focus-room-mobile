/android
/ios

# Derleme çıktıları
*.apk
*.aab
*.ipa

# Claude Code kişisel ayarları
.claude/settings.local.json

# graphify çıktısı — yalnız özet rapor izlenir
graphify-out/*
!graphify-out/GRAPH_REPORT.md
